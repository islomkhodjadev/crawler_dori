DORI_DB=data/dori.sqlite3
CRAWL_DELAY_SECONDS=3
CRAWL_MAX_PAGES=3
# Optional: AI attribute suggestions; enable explicitly per product in the UI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional browser installation directory (otherwise Playwright default)
# PLAYWRIGHT_BROWSERS_PATH=
# Optional trusted proxy URL for Chromium, if your deployment requires it
# DORI_BROWSER_PROXY=
# Optional, paid: parse visible Oson search results if JSON-LD is unavailable.
# AI-parsed candidates always require manual review; cannot recover blocked pages.
OPENAI_PARSE_HTML=false
# Reuse cookies established with `dori browser-session --site oson`:
# DORI_BROWSER_PROFILE=browser-profile
# DORI_HEADLESS=false
